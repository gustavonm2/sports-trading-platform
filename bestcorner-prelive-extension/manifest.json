{
  "manifest_version": 3,
  "name": "BestCorner Pré-Live — Sports Trading",
  "version": "1.0.0",
  "description": "Extrai estatísticas pré-live de escanteio (HT/FT taxas limite e médias) e sincroniza com o TradePro.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.supabase.co/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.bestcornerstats.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
